{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@monkeytype/schemas/*": ["./src/packages/schemas/src/*"],
      "@monkeytype/util/*": ["./src/packages/util/src/*"],
      "@monkeytype/funbox": ["./src/packages/funbox/src/index.ts"],
      "@monkeytype/funbox/*": ["./src/packages/funbox/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
