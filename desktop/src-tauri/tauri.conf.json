{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monkeytype",
  "version": "0.4.7",
  "identifier": "com.monkeytype.desktop",
  "build": {
    "beforeDevCommand": "MONKEYTYPE_DESKTOP=true pnpm --dir .. dev-fe",
    "beforeBuildCommand": "MONKEYTYPE_DESKTOP=true pnpm --dir .. build-fe",
    "devUrl": "http://127.0.0.1:3000/desktop.html",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "desktop.html",
        "title": "Monkeytype",
        "width": 1200,
        "height": 720,
        "maximized": true,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "media-src": "'self' blob:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      },
      "capabilities": ["main-window"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "26.0",
      "signingIdentity": "-",
      "hardenedRuntime": true
    }
  }
}
